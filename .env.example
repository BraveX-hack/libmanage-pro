# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Sécurité & serveur (BiblioTech) ---
# Secret de signature des sessions (OBLIGATOIRE en production, 32+ caractères aléatoires).
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
# Mot de passe du compte super-administrateur (appliqué au démarrage s'il est défini).
ADMIN_PASSWORD=""
# Port d'écoute (défaut 3000)
PORT=3000
# Dossier de la base JSON (défaut ./data)
DATA_DIR=""
# "1" si l'app est derrière un reverse proxy (pour req.ip et cookies Secure)
TRUST_PROXY=""
# "true" pour autoriser le paiement SIMULÉ en production (sinon désactivé)
PAYMENT_SIMULATION=""

# --- Paiement Bachs ---
# Clé secrète Bachs (sandbox : sk_sandbox_...). NE JAMAIS la mettre dans le code ni la publier.
BACHS_API_KEY=""
# Produit Bachs utilisé par défaut (id commençant par prod_)
PRODUIT_ID=""
# Optionnel : un produit Bachs par formule (le prix est défini dans le produit Bachs)
BACHS_PRODUCT_ETUDIANT_PLUS=""
BACHS_PRODUCT_RECHERCHE_DOCTORAT=""
# Sandbox par défaut ; en production : https://api.bachs.io
BACHS_URL="https://sandbox-api.bachs.io"
# Adresse PUBLIQUE de votre site (https). Bachs refuse localhost : en local, laissez vide.
APP_PUBLIC_URL=""

# --- Réservations payantes (Bachs) ---
# Produit Bachs à "prix personnalisé" (price_type: custom) utilisé pour payer les réservations :
# le serveur lui envoie le total du panier. À défaut, PRODUIT_ID est utilisé (le prix doit alors être modifiable).
BACHS_PRODUCT_RESERVATION=""
# Nombre de FCFA pour 1 unité de la devise du produit Bachs (1 si le produit est en FCFA ; ex. ~585 si le produit est en USD)
BACHS_CURRENCY_RATE="1"
