(-- Définition des Tables et Contraintes d'Intégrité Référentielle) Tj
T* (CREATE TABLE categories \() Tj
T* (  code_cat VARCHAR\(32\) PRIMARY KEY,) Tj
T* (  libelle VARCHAR\(100\) NOT NULL,) Tj
T* (  cote_dewey VARCHAR\(10\) NOT NULL,) Tj
T* (  duree_standard INT DEFAULT 14) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE livres \() Tj
T* (  id_livre VARCHAR\(32\) PRIMARY KEY,) Tj
T* (  titre VARCHAR\(255\) NOT NULL,) Tj
T* (  auteur VARCHAR\(150\) NOT NULL,) Tj
T* (  isbn VARCHAR\(20\) UNIQUE NOT NULL,) Tj
T* (  code_cat VARCHAR\(32\) REFERENCES categories\(code_cat\) ON DELETE RESTRICT,) Tj
T* (  stock_total INT NOT NULL CHECK \(stock_total >= 0\),) Tj
T* (  stock_dispo INT NOT NULL CHECK \(stock_dispo >= 0 AND stock_dispo <= stock_total\),) Tj
T* (  rayon VARCHAR\(20\) NOT NULL) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE adherents \() Tj
T* (  id_adherent VARCHAR\(32\) PRIMARY KEY,) Tj
T* (  nom VARCHAR\(50\) NOT NULL,) Tj
T* (  prenom VARCHAR\(50\) NOT NULL,) Tj
T* (  email VARCHAR\(100\) UNIQUE NOT NULL,) Tj
T* (  num_carte VARCHAR\(20\) UNIQUE NOT NULL,) Tj
T* (  filiere VARCHAR\(50\) NOT NULL,) Tj
T* (  statut_compte VARCHAR\(20\) DEFAULT 'actif' CHECK \(statut_compte IN \('actif', 'suspendu'\)\)) Tj
T* (\);) Tj
T* () Tj
T* (CREATE TABLE emprunts \() Tj
T* (  id_emprunt VARCHAR\(32\) PRIMARY KEY,) Tj
T* (  reference VARCHAR\(32\) UNIQUE NOT NULL,) Tj
T* (  id_adherent VARCHAR\(32\) REFERENCES adherents\(id_adherent\),) Tj
T* (  id_livre VARCHAR\(32\) REFERENCES livres\(id_livre\),) Tj
T* (  date_emprunt DATE NOT NULL DEFAULT CURRENT_DATE,) Tj
T* (  date_echeance DATE NOT NULL,) Tj
T* (  date_retour DATE NULL,) Tj
T* (  statut VARCHAR\(20\) DEFAULT 'en_cours' CHECK \(statut IN \('en_cours', 'en_retard', 'restitue'\)\),) Tj
T* (  penalite INT DEFAULT 0 CHECK \(penalite >= 0\)) Tj
