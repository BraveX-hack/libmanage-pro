(// Génération de l'empreinte de sécurité et instanciation de la quittance officielle) Tj
T* (export function generateSecureReceipt\(loan: Loan, user: User, book: Book\): Receipt {) Tj
T* (  const timestamp = new Date\(\).toISOString\(\);) Tj
T* (  const rawSignature = `${loan.id}-${user.id}-${book.id}-${loan.dueDate}-${timestamp}`;) Tj
T* (  ) Tj
T* (  // Calcul d'une empreinte de sécurité pseudo-cryptographique unique) Tj
T* (  let hash = 0;) Tj
T* (  for \(let i = 0; i < rawSignature.length; i++\) {) Tj
T* (    const char = rawSignature.charCodeAt\(i\);) Tj
T* (    hash = \(hash << 5\) - hash + char;) Tj
T* (    hash |= 0; // Conversion en entier 32 bits) Tj
T* (  }) Tj
T* (  const securityHash = 'SHA256-ESGIS-' + Math.abs\(hash\).toString\(16\).toUpperCase\(\);) Tj
T* () Tj
T* (  return {) Tj
T* (    reference: 'QUI-' + Date.now\(\).toString\(36\).toUpperCase\(\) + '-' + Math.floor\(Math.random\(\) * 899 + 100\),) Tj
T* (    loanId: loan.id,) Tj
T* (    bookTitle: book.title,) Tj
T* (    studentName: user.name,) Tj
T* (    studentCardId: user.studentCardId || 'ESGIS-2026',) Tj
T* (    borrowDate: loan.borrowDate,) Tj
T* (    dueDate: loan.dueDate,) Tj
T* (    securityFingerprint: securityHash,) Tj
T* (    issuedAt: timestamp,) Tj
T* (    certifiedBy: 'Direction des Ressources Documentaires ESGIS') Tj
T* (  };) Tj
T* (}) Tj
ET
