(// Traitement prioritaire d'une restitution d'ouvrage avec file d'attente FIFO) Tj
T* (export function processBookReturn\(bookId: string, currentReservations: Reservation[]\): {) Tj
T* (  nextBeneficiary: Reservation | null;) Tj
T* (  newBookStatus: 'disponible' | 'reserve';) Tj
T* (} {) Tj
T* (  // Extraction des réservations actives pour ce livre, triées par date croissante) Tj
T* (  const waitingQueue = currentReservations) Tj
T* (    .filter\(r => r.bookId === bookId && r.status === 'en_attente'\)) Tj
T* (    .sort\(\(a, b\) => new Date\(a.requestDate\).getTime\(\) - new Date\(b.requestDate\).getTime\(\)\);) Tj
T* () Tj
T* (  if \(waitingQueue.length > 0\) {) Tj
T* (    const nextBeneficiary = waitingQueue[0];) Tj
T* (    nextBeneficiary.status = 'notifie';) Tj
T* (    nextBeneficiary.notificationExpiry = new Date\(Date.now\(\) + 48 * 3600 * 1000\).toISOString\(\);) Tj
T* (    return { nextBeneficiary, newBookStatus: 'reserve' };) Tj
T* (  }) Tj
T* () Tj
T* (  return { nextBeneficiary: null, newBookStatus: 'disponible' };) Tj
T* (}) Tj
