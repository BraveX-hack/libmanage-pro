(// Traitement sécurisé de l'emprunt avec vérification atomique de seuil de stock) Tj
T* (app.post\('/api/database/borrow', \(req: Request, res: Response\) => {) Tj
T* (  const { bookId, userId } = req.body;) Tj
T* (  const db = readDb\(\); // Lecture synchrone protégée) Tj
T* () Tj
T* (  const book = db.books.find\(b => b.id === bookId\);) Tj
T* (  const user = db.users.find\(u => u.id === userId\);) Tj
T* () Tj
T* (  // 1. Vérification de la disponibilité effective) Tj
T* (  if \(!book || book.availableCopies <= 0\) {) Tj
T* (    return res.status\(409\).json\({ ) Tj
T* (      error: 'CONFLIT_STOCK_ÉPUISÉ',) Tj
T* (      message: 'Cet ouvrage vient d\\'être emprunté par un autre adhérent.') Tj
T* (    }\);) Tj
T* (  }) Tj
T* () Tj
T* (  // 2. Décrémentation atomique et persistance immédiate) Tj
T* (  book.availableCopies -= 1;) Tj
T* (  const newLoan = createLoanRecord\(user, book\);) Tj
T* (  db.loans.push\(newLoan\);) Tj
T* (  writeDb\(db\); // Écriture atomique sur /data/database.json) Tj
T* () Tj
T* (  return res.status\(200\).json\({ success: true, loan: newLoan }\);) Tj
T* (}\);) Tj
ET
