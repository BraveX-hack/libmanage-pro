(// Moteur algorithmique de détection des retards et calcul des indemnités forfaitaires) Tj
T* (export interface PenaltyResult {) Tj
T* (  isOverdue: boolean;) Tj
T* (  daysLate: number;) Tj
T* (  penaltyFee: number;) Tj
T* (}) Tj
T* () Tj
T* (export function computeLoanPenalty\(loan: Loan, ratePerDay: number = 200\): PenaltyResult {) Tj
T* (  if \(loan.status === 'restitue'\) {) Tj
T* (    return { isOverdue: false, daysLate: 0, penaltyFee: loan.accumulatedPenalty || 0 };) Tj
T* (  }) Tj
T* () Tj
T* (  const currentDate = new Date\(\);) Tj
T* (  const dueDate = new Date\(loan.dueDate\);) Tj
T* (  ) Tj
T* (  // Calcul de la différence en millisecondes et conversion en jours calendaires entiers) Tj
T* (  const diffTime = currentDate.getTime\(\) - dueDate.getTime\(\);) Tj
T* (  const daysLate = Math.ceil\(diffTime / \(1000 * 60 * 60 * 24\)\);) Tj
T* () Tj
T* (  if \(daysLate > 0\) {) Tj
T* (    const penaltyFee = daysLate * ratePerDay;) Tj
T* (    return { isOverdue: true, daysLate, penaltyFee };) Tj
T* (  }) Tj
T* () Tj
T* (  return { isOverdue: false, daysLate: 0, penaltyFee: 0 };) Tj
T* (}) Tj
